---
import ArticleCard from '../articles/ArticleCard.astro';
import Button from '../ui/Button.astro';
import { url } from '../../utils/url';
import { getLang, pot } from '../../i18n';
import { slovar } from '../../i18n/slovar';
import { clankiV } from '../../i18n/clanki';

const lang = getLang(Astro.url.pathname);
const t = slovar(lang).home;
const latestArticles = (await clankiV(lang)).slice(0, 3);
---

<section class="latest-articles">
  <div class="container">
    <div class="latest-articles__header fade-in">
      <div>
        <h2 class="latest-articles__title">{t.zadnje}</h2>
        <p class="latest-articles__subtitle">{t.zadnjePodnaslov}</p>
      </div>
      <Button href={url(pot('analize', lang))} variant="ghost" size="sm">
        {t.vse}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </Button>
    </div>

    {latestArticles.length > 0 ? (
      <div class="latest-articles__grid">
        {latestArticles.map((article, i) => (
          <div class="fade-in" style={`transition-delay: ${i * 80}ms`}>
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              pubDate={article.data.pubDate}
              readingTime={article.data.readingTime}
              category={article.data.category}
              slug={article.id}
              featured={article.data.featured}
            />
          </div>
        ))}
      </div>
    ) : (
      <p class="latest-articles__empty">{t.kmalu}</p>
    )}
  </div>
</section>

<style>
  .latest-articles {
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .latest-articles__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
    flex-wrap: wrap;
  }

  .latest-articles__title {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-xs);
  }

  .latest-articles__subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .latest-articles__empty {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .latest-articles__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  @media (max-width: 1024px) {
    .latest-articles__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .latest-articles__grid {
      grid-template-columns: 1fr;
    }

    .latest-articles__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
