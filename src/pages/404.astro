---
// Stran za neznane naslove (avtor, 24. 9. 2026). Brez nje GitHub Pages postreže svojo belo stran
// "Page not found · GitHub Pages" v angleščini, brez menija in brez poti nazaj.
// Astro iz te datoteke naredi 404.html, ki jo GitHub Pages samodejno uporabi za vse neznane naslove.
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV_LINKS } from '../config';

const poti = [
  { ...NAV_LINKS.find((l) => l.href === '/analize'), opis: 'Tedenski pregledi trgov in poglobljene analize podjetij.' },
  { ...NAV_LINKS.find((l) => l.href === '/koledar'), opis: 'Objave centralnih bank, gospodarski podatki in rezultati podjetij.' },
  { ...NAV_LINKS.find((l) => l.href === '/kalkulatorji'), opis: 'Investicijski kalkulator in kalkulator pričakovanega donosa.' },
];
---

<BaseLayout title="Te strani ni" description="Naslov ne obstaja ali pa je bil premaknjen. Tu so analize, koledar in kalkulatorji.">
  <div class="ni">
    <p class="ni__koda">404</p>
    <h1 class="ni__naslov">Te strani ni</h1>
    <p class="ni__lead">Naslov ne obstaja ali pa je bil premaknjen. Morda je bila povezava pri deljenju odrezana.</p>

    <ul class="ni__seznam">
      {poti.map((p) => (
        <li>
          <a href={p.href} class="ni__povezava">
            <span class="ni__ime">{p.label}</span>
            <span class="ni__opis">{p.opis}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="ni__nazaj"><a href="/">Nazaj na domačo stran</a></p>
  </div>
</BaseLayout>

<style>
  .ni { max-width: 640px; margin: 0 auto; padding: var(--space-3xl) var(--space-md); text-align: center; }
  .ni__koda { font-size: var(--text-sm); font-weight: 700; letter-spacing: 0.18em; color: var(--color-text-subtle); margin-bottom: var(--space-sm); }
  .ni__naslov { font-size: var(--text-3xl); font-weight: 700; letter-spacing: -0.02em; margin-bottom: var(--space-sm); }
  .ni__lead { color: var(--color-text-muted); line-height: 1.6; margin-bottom: var(--space-2xl); }
  .ni__seznam { list-style: none; padding: 0; margin: 0 0 var(--space-xl); display: grid; gap: var(--space-md); text-align: left; }
  .ni__povezava {
    display: block; text-decoration: none; background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); padding: var(--space-md) var(--space-lg);
    transition: border-color var(--transition-fast, .15s), transform var(--transition-fast, .15s);
  }
  .ni__povezava:hover { border-color: var(--color-accent-border); transform: translateY(-2px); }
  .ni__ime { display: block; font-weight: 700; color: var(--color-text); margin-bottom: 0.15rem; }
  .ni__opis { display: block; font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.5; }
  .ni__nazaj a { color: var(--color-text-muted); font-size: var(--text-sm); }
  .ni__nazaj a:hover { color: var(--color-accent); }
</style>
