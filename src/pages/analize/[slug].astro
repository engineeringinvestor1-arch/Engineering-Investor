---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { jezikiClanka } from '../../i18n/clanki';

export async function getStaticPaths() {
  const articles = await getCollection('analize');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
// Če ima članek prevod, gumb za jezik vodi nanj; sicer na seznam analiz v tistem jeziku.
const alternates = await jezikiClanka('sl', article);
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  pubDate={article.data.pubDate}
  readingTime={article.data.readingTime}
  category={article.data.category}
  image={article.data.image}
  alternates={alternates}
>
  <Content />
</ArticleLayout>
